# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler" (IPv4 uchun)
# Lokal test uchun: postgresql://postgres:postgres@localhost:5432/glasskanban
DATABASE_URL=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Uzun, tesadufi bir sozdur. Hech kimə göstərmə.
JWT_SECRET=change-me-to-a-long-random-string

# Frontend ünvanı (CORS üçün). Bir neçə ünvan olarsa vergüllə ayır.
CLIENT_URL=http://localhost:3000,https://glass-kanban-iota.vercel.app

PORT=5000
